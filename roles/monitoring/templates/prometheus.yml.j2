# Managed by keelinfra
global:
  scrape_interval: 15s
  evaluation_interval: 30s

rule_files:
  - /etc/prometheus/rules/*.yml

scrape_configs:
  - job_name: node
    static_configs:
{% for node in cluster_nodes %}
      - targets: ["{{ node.host }}:{{ node_exporter_port }}"]
        labels: {instance: "{{ node.name }}"}
{% endfor %}

  - job_name: postgres
    static_configs:
{% for node in cluster_nodes %}
      - targets: ["{{ node.host }}:{{ postgres_exporter_port }}"]
        labels: {instance: "{{ node.name }}"}
{% endfor %}

  - job_name: patroni
    static_configs:
{% for node in cluster_nodes %}
      - targets: ["{{ node.host }}:{{ patroni_rest_port }}"]
        labels: {instance: "{{ node.name }}"}
{% endfor %}

  - job_name: etcd
    static_configs:
{% for node in cluster_nodes %}
      - targets: ["{{ node.host }}:2379"]
        labels: {instance: "{{ node.name }}"}
{% endfor %}

  - job_name: keycloak
    scheme: https
    tls_config:
      insecure_skip_verify: true
    static_configs:
{% for node in cluster_nodes %}
      - targets: ["{{ node.host }}:{{ keycloak_mgmt_port }}"]
        labels: {instance: "{{ node.name }}"}
{% endfor %}
