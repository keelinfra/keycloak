# Managed by keelinfra
global:
  scrape_interval: 15s
  evaluation_interval: 30s

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["127.0.0.1:{{ alertmanager_port }}"]

rule_files:
  - /etc/prometheus/rules/*.yml

{% set internal_scrape %}
{% if internal_tls | default(false) | bool %}
    scheme: https
    tls_config:
      ca_file: {{ internal_ca_file }}
      cert_file: {{ internal_cert_file }}
      key_file: {{ internal_key_file }}
{% endif %}
{% endset %}
scrape_configs:
  - job_name: node
{{ internal_scrape }}    static_configs:
{% for node in cluster_nodes %}
      - targets: ["{{ node.host }}:{{ node_exporter_port }}"]
        labels: {instance: "{{ node.name }}"}
{% endfor %}

  - job_name: postgres
{{ internal_scrape }}    static_configs:
{% for node in cluster_nodes %}
      - targets: ["{{ node.host }}:{{ postgres_exporter_port }}"]
        labels: {instance: "{{ node.name }}"}
{% endfor %}

  - job_name: patroni
{{ internal_scrape }}    static_configs:
{% for node in cluster_nodes %}
      - targets: ["{{ node.host }}:{{ patroni_rest_port }}"]
        labels: {instance: "{{ node.name }}"}
{% endfor %}

  - job_name: etcd
{{ internal_scrape }}    static_configs:
{% for node in cluster_nodes %}
      - targets: ["{{ node.host }}:{{ etcd_client_port | default(2379) }}"]
        labels: {instance: "{{ node.name }}"}
{% endfor %}

  - job_name: keycloak
    scheme: https
    tls_config:
      insecure_skip_verify: true
    static_configs:
{% for node in cluster_nodes %}
      - targets: ["{{ node.host }}:{{ keycloak_mgmt_port }}"]
        labels: {instance: "{{ node.name }}"}
{% endfor %}

  # This node's own Alertmanager, for the size of its cluster.
  - job_name: alertmanager
    static_configs:
      - targets: ["127.0.0.1:{{ alertmanager_port }}"]
        labels: {instance: "{{ inventory_hostname }}"}
