# Managed by keelinfra — the alerts that actually page you
groups:
  - name: keelinfra-core
    rules:
      - alert: KeycloakDown
        expr: up{job="keycloak"} == 0
        for: 2m
        labels: {severity: critical}
        annotations:
          summary: "Keycloak on {{ '{{ $labels.instance }}' }} is down"

      - alert: PostgresDown
        expr: up{job="patroni"} == 0
        for: 2m
        labels: {severity: critical}
        annotations:
          summary: "Patroni/PostgreSQL on {{ '{{ $labels.instance }}' }} is down"

      - alert: NoPostgresLeader
        expr: sum(patroni_primary) == 0 or absent(patroni_primary)
        for: 1m
        labels: {severity: critical}
        annotations:
          summary: "PostgreSQL cluster has no leader — writes are failing"

      - alert: PostgresReplicationLag
        expr: ((scalar(max(patroni_xlog_location)) - patroni_xlog_replayed_location) and on(instance) (patroni_replica == 1)) > 104857600
        for: 5m
        labels: {severity: warning}
        annotations:
          summary: "Replica {{ '{{ $labels.instance }}' }} is {{ '{{ $value | humanize1024 }}' }}B behind"

      - alert: BackupTooOld
        expr: time() - pgbackrest_last_backup_timestamp > 93600
        for: 1h
        labels: {severity: warning}
        annotations:
          summary: "Last pgBackRest backup in repo {{ '{{ $labels.repo }}' }} is older than 26 hours"

      - alert: EtcdNoLeader
        expr: etcd_server_has_leader == 0
        for: 1m
        labels: {severity: critical}
        annotations:
          summary: "etcd on {{ '{{ $labels.instance }}' }} has no leader — Patroni cannot fail over"

      - alert: ExporterDown
        expr: up{job=~"node|postgres|etcd"} == 0
        for: 5m
        labels: {severity: warning}
        annotations:
          summary: "{{ '{{ $labels.job }}' }} metrics on {{ '{{ $labels.instance }}' }} are not being scraped"

      - alert: DiskAlmostFull
        expr: node_filesystem_avail_bytes{mountpoint="/"} / node_filesystem_size_bytes{mountpoint="/"} < 0.15
        for: 10m
        labels: {severity: warning}
        annotations:
          summary: "{{ '{{ $labels.instance }}' }} root filesystem below 15% free"
