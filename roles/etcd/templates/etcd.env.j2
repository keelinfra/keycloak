# Managed by keelinfra — etcd member configuration
{% set scheme = 'https' if internal_tls | default(false) | bool else 'http' %}
ETCD_NAME={{ inventory_hostname }}
ETCD_DATA_DIR={{ etcd_data_dir }}
ETCD_LISTEN_PEER_URLS={{ scheme }}://{{ ansible_host }}:{{ etcd_peer_port }}
ETCD_LISTEN_CLIENT_URLS={{ scheme }}://{{ ansible_host }}:{{ etcd_client_port }},{{ scheme }}://127.0.0.1:{{ etcd_client_port }}
ETCD_INITIAL_ADVERTISE_PEER_URLS={{ scheme }}://{{ ansible_host }}:{{ etcd_peer_port }}
ETCD_ADVERTISE_CLIENT_URLS={{ scheme }}://{{ ansible_host }}:{{ etcd_client_port }}
ETCD_INITIAL_CLUSTER={% for node in cluster_nodes %}{{ node.name }}={{ scheme }}://{{ node.host }}:{{ etcd_peer_port }}{% if not loop.last %},{% endif %}{% endfor %}

{# "existing" only when ./replace-node joins a new machine. A comment, so the file other nodes render does not change. #}
ETCD_INITIAL_CLUSTER_STATE={{ etcd_initial_cluster_state | default('new') }}
ETCD_INITIAL_CLUSTER_TOKEN={{ cluster_name }}-etcd
ETCD_ENABLE_V2=false
ETCD_AUTO_COMPACTION_RETENTION=1
{% if internal_tls | default(false) | bool %}
# Clients (Patroni, Prometheus, etcdctl) and peers must present a
# certificate from the cluster-internal CA.
ETCD_CERT_FILE={{ internal_cert_file }}
ETCD_KEY_FILE={{ internal_key_file }}
ETCD_TRUSTED_CA_FILE={{ internal_ca_file }}
ETCD_CLIENT_CERT_AUTH=true
ETCD_PEER_CERT_FILE={{ internal_cert_file }}
ETCD_PEER_KEY_FILE={{ internal_key_file }}
ETCD_PEER_TRUSTED_CA_FILE={{ internal_ca_file }}
ETCD_PEER_CLIENT_CERT_AUTH=true
{% endif %}
