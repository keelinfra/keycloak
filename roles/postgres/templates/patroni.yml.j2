# Managed by keelinfra — Patroni configuration
scope: {{ cluster_name }}
name: {{ inventory_hostname }}

etcd3:
  hosts:
{% for node in cluster_nodes %}
    - {{ node.host }}:2379
{% endfor %}
{% if internal_tls | default(false) | bool %}
  protocol: https
  cacert: {{ internal_ca_file }}
  cert: {{ internal_cert_file }}
  key: {{ internal_key_file }}
{% endif %}

restapi:
  listen: {{ ansible_host }}:{{ patroni_rest_port }}
  connect_address: {{ ansible_host }}:{{ patroni_rest_port }}
  authentication:
    username: patroni
    password: {{ vault_patroni_api_password }}
{% if internal_tls | default(false) | bool %}
  certfile: {{ internal_cert_file }}
  keyfile: {{ internal_key_file }}
  cafile: {{ internal_ca_file }}

# patronictl, and Patroni calling the other members' API
ctl:
  cacert: {{ internal_ca_file }}
  certfile: {{ internal_cert_file }}
  keyfile: {{ internal_key_file }}
{% endif %}

bootstrap:
  dcs:
    ttl: 30
    loop_wait: 10
    retry_timeout: 10
    maximum_lag_on_failover: 1048576
    postgresql:
      use_pg_rewind: true
      parameters:
        archive_mode: "on"
        archive_command: /bin/true   # replaced by pgBackRest once the repo is set up
        archive_timeout: 60s
  initdb:
    - encoding: UTF8
    - data-checksums

postgresql:
  listen: "{{ ansible_host }},127.0.0.1:{{ postgres_port }}"
  connect_address: {{ ansible_host }}:{{ postgres_port }}
  data_dir: {{ postgres_data_dir }}
  bin_dir: {{ postgres_bin_dir }}
  pgpass: {{ postgres_home }}/.pgpass_patroni
  # Kept here, not under bootstrap, so a rerun applies changes to it.
  # With internal TLS, connections from the nodes must use TLS (hostssl).
  pg_hba:
    - local all all peer
    - host all all 127.0.0.1/32 scram-sha-256
    # Patroni reads this node's timeline over a replication connection to
    # localhost. Without it, a leader that crashed and lost its place never
    # gets pg_rewind and stays a broken replica on its old timeline.
    - host replication replicator 127.0.0.1/32 scram-sha-256
{% for node in cluster_nodes %}
    - {{ 'hostssl' if internal_tls | default(false) | bool else 'host' }} all all {{ node.host }}/32 scram-sha-256
    - {{ 'hostssl' if internal_tls | default(false) | bool else 'host' }} replication replicator {{ node.host }}/32 scram-sha-256
{% endfor %}
  authentication:
    superuser:
      username: postgres
      password: {{ vault_postgres_superuser_password }}
{% if internal_tls | default(false) | bool %}
      sslmode: verify-full
      sslrootcert: {{ internal_ca_file }}
{% endif %}
    replication:
      username: replicator
      password: {{ vault_postgres_replication_password }}
{% if internal_tls | default(false) | bool %}
      sslmode: verify-full
      sslrootcert: {{ internal_ca_file }}
{% endif %}
  parameters:
{% for k, v in postgres_parameters.items() %}
    {{ k }}: {{ v }}
{% endfor %}
{% if internal_tls | default(false) | bool %}
    ssl: "on"
    ssl_cert_file: {{ internal_cert_file }}
    ssl_key_file: {{ internal_key_file }}
    ssl_ca_file: {{ internal_ca_file }}
    ssl_min_protocol_version: TLSv1.2
{% endif %}
