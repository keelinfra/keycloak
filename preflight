#!/usr/bin/env bash
# keelinfra/keycloak — preflight: check the nodes before installing on them.
# Usage: ./preflight
# Changes nothing. ./install runs the same checks first.
set -euo pipefail
cd "$(dirname "$0")"
# The Docker cluster from ./try: this machine may not reach its nodes (macOS),
# so run in the cluster's control container instead.
if [[ -f .dev/containers/cluster.yml ]] && command -v docker >/dev/null; then
  echo "(./try cluster: running in its control container, as dev/ha-exec.sh ./${0##*/})" >&2
  exec dev/ha-exec.sh "./${0##*/}" "$@"
fi
[[ -f inventory/hosts.yml ]] || { echo "error: no inventory found — run ./configure first" >&2; exit 1; }
export ANSIBLE_VAULT_PASSWORD_FILE="$PWD/inventory/.vault_pass"
exec ansible-playbook playbooks/preflight.yml "$@"
