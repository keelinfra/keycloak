---
# Generated by ./configure from {{ config_file | basename }} — do not edit by hand.
all:
  children:
    cluster:
      # become stays scoped to cluster nodes — localhost plays must not sudo
      vars:
        ansible_user: {{ cfg.ssh_user }}
{% if cfg.ssh_private_key is defined %}
        ansible_ssh_private_key_file: {{ cfg.ssh_private_key }}
{% endif %}
        ansible_become: true
      hosts:
{% for node in cfg.nodes %}
        {{ node.name }}:
          ansible_host: {{ node.host }}
          node_id: {{ loop.index }}
{% if node.connection is defined %}
          ansible_connection: {{ node.connection }}
{% endif %}
{% endfor %}
    etcd:
      children: { cluster: }
    postgres:
      children: { cluster: }
    keycloak:
      children: { cluster: }
    haproxy:
      children: { cluster: }
    # first node: schema migrations, drills, and other run-once plays
    primary:
      hosts:
        {{ cfg.nodes[0].name }}:
    monitoring:
      hosts:
        {{ cfg.nodes[0].name }}:
    backup_repo:
      hosts:
        {{ cfg.nodes[0].name }}:
