---
# Generated by ./configure from {{ config_file | basename }} — do not edit by hand.
cluster_name: {{ cfg.cluster_name }}
keycloak_domain: {{ cfg.domain }}
keycloak_version: "{{ cfg.keycloak_version }}"
cluster_vip: "{{ cfg.vip | default('') }}"
tls_mode: {{ cfg.tls_mode | default('selfsigned') }}
cluster_nodes:
{% for node in cfg.nodes %}
  - name: {{ node.name }}
    host: {{ node.host }}
    node_id: {{ loop.index }}
{% endfor %}
