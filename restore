#!/usr/bin/env bash
# keelinfra/keycloak — restore: put the database back from a pgBackRest backup.
# Usage: ./restore [--repo 1|2] [--time "2026-10-17 09:30:00+00"] [--yes]
# Without --time: the newest backup plus every archived WAL segment, i.e. as
# close to now as the archive goes. With --time: the state at that moment.
# Keycloak is down while it runs. Every node's current data directory is
# kept beside the new one (<data dir>.before-restore-<time>).
set -euo pipefail
cd "$(dirname "$0")"

REPO=1 TIME="" YES=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --repo) REPO="$2"; shift 2 ;;
    --time) TIME="$2"; shift 2 ;;
    --yes) YES=true; shift ;;
    -h|--help) sed -n '3,7p' "$0"; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 1 ;;
  esac
done
[[ "$REPO" =~ ^[12]$ ]] || { echo "error: --repo is 1 or 2" >&2; exit 1; }
[[ -f inventory/hosts.yml ]] || { echo "error: no inventory found — run ./configure first" >&2; exit 1; }
export ANSIBLE_VAULT_PASSWORD_FILE="$PWD/inventory/.vault_pass"

CLUSTER=$(awk '/^cluster_name:/ {print $2}' inventory/group_vars/all/cluster.yml | tr -d '"')
if ! $YES; then
  echo "This stops Keycloak and replaces the database on every node of '$CLUSTER'"
  echo "with repository $REPO's backup${TIME:+ as of $TIME}. Users cannot log in until it finishes."
  read -r -p "Type the cluster name to continue: " answer
  [[ "$answer" == "$CLUSTER" ]] || { echo "cancelled" >&2; exit 1; }
fi

exec ansible-playbook playbooks/restore.yml \
  -e "restore_confirmed=$CLUSTER" -e "restore_repo=$REPO" -e "restore_time=$TIME"
