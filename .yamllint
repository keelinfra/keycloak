---
extends: default
rules:
  line-length:
    max: 140
  truthy:
    allowed-values: ["true", "false"]
  comments:
    min-spaces-from-content: 1
  # ansible-lint refuses a yamllint config without these three
  comments-indentation: false
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  braces:
    max-spaces-inside: 1
ignore:
  - inventory/
  - .github/
  - .dev/
  - .ansible/
